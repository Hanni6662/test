APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
IMAGE_SERVICE_TOKEN=
# Must exactly match backend IMAGE_BACKEND_GENERATION_PERMIT_SECRET for H4 permit v2.
# Required for new H8 Chatflow v3 requests; v1 legacy remains separate.
IMAGE_SERVICE_GENERATION_PERMIT_SECRET=
# H8 v3 reads reference bytes only from this fixed backend origin. Configure both values.
IMAGE_SERVICE_REFERENCE_BACKEND_ORIGIN=
IMAGE_SERVICE_REFERENCE_BACKEND_TOKEN=
IMAGE_SERVICE_MAX_ACTIVE_SLOTS=2
# Only for a local DNS proxy using 198.18.0.0/15 fake IPs; otherwise leave empty.
IMAGE_SERVICE_RESULT_FAKE_IP_HOSTS=
