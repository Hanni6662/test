{
  "type": "object",
  "properties": {
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "品牌导购主视觉",
              "核心卖点信息图",
              "生活方式海报",
              "多场景展示图",
              "场景化卖点图",
              "使用体验图",
              "SKU展示图",
              "细节展示图"
            ]
          },
          "canvas": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reference_plan": {
            "type": "object",
            "properties": {
              "identity_anchor_id": {
                "type": "string",
                "enum": [
                  "PRIMARY"
                ]
              },
              "view_reference_ids": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "enum": [
                    "AUX01",
                    "AUX02",
                    "AUX03"
                  ]
                }
              },
              "excluded_reference_ids": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "type": "string"
                }
              },
              "target_view": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "identity_anchor_id",
              "view_reference_ids",
              "excluded_reference_ids",
              "target_view"
            ],
            "additionalProperties": false
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5"
                  ]
                },
                "use": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "required": [
                "field",
                "use"
              ],
              "additionalProperties": false
            }
          },
          "design_prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "type",
          "canvas",
          "reference_plan",
          "resources",
          "design_prompt"
        ],
        "additionalProperties": false
