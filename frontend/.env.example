# 只配置公开地址，不填写 Dify/APIMart/内部接口密钥。
BACKEND_API_TARGET=http://127.0.0.1:18160
# 后端已有 allowlist 中的 origin；本地代理在验证浏览器同源后使用它。
BACKEND_TRUSTED_ORIGIN=http://127.0.0.1:18160
FRONTEND_PORT=5173
# standalone: 参考组 → 推荐 → tasks；chatflow: 参考组 → business-sessions → selection
VITE_FLOW_MODE=standalone
VITE_RUNTIME_LABEL=本地 mock · 最新后端
