# Prefer .\scripts\init-local-env.ps1. If editing manually, migration/runtime DB passwords must be 64 URL-safe characters.
# These credentials are for the isolated image-backend stack only.
IMAGE_BACKEND_DB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
IMAGE_BACKEND_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
IMAGE_BACKEND_RUNTIME_PASSWORD=CHANGE_ME_RUNTIME_PASSWORD
IMAGE_BACKEND_RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

IMAGE_BACKEND_TEST_DB_ADMIN_PASSWORD=CHANGE_ME_TEST_ADMIN_PASSWORD
IMAGE_BACKEND_TEST_MIGRATOR_PASSWORD=CHANGE_ME_TEST_MIGRATOR_PASSWORD
IMAGE_BACKEND_TEST_RUNTIME_PASSWORD=CHANGE_ME_TEST_RUNTIME_PASSWORD
IMAGE_BACKEND_TEST_RABBITMQ_PASSWORD=CHANGE_ME_TEST_RABBITMQ_PASSWORD

IMAGE_BACKEND_DATABASE_URL=postgresql+psycopg://image_backend_runtime:CHANGE_ME_RUNTIME_PASSWORD@db:5432/image_backend
IMAGE_BACKEND_MIGRATION_DATABASE_URL=postgresql+psycopg://image_backend_migrator:CHANGE_ME_MIGRATOR_PASSWORD@db:5432/image_backend
IMAGE_BACKEND_BROKER_URL=amqp://image_backend:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/image_backend
# Independent mock callback Bearer secret; keep blank to disable /internal routes.
IMAGE_BACKEND_DIFY_CALLBACK_SECRET=
# Dedicated HMAC key for the private H4 permit route; keep blank to leave that route unmounted.
IMAGE_BACKEND_GENERATION_PERMIT_SECRET=
# Independent maintenance Bearer secret; keep blank to disable maintenance routes.
IMAGE_BACKEND_MAINTENANCE_SECRET=
IMAGE_BACKEND_CLEANUP_SCHEDULE_TIMEZONE=Asia/Shanghai
# Local wall-clock HH:MM in the configured timezone; do not include a UTC offset.
IMAGE_BACKEND_CLEANUP_SCHEDULE_DAILY_TIME=03:00
IMAGE_BACKEND_CLEANUP_BATCH_SIZE=25
IMAGE_BACKEND_QUEUE_NAME=image-backend-events
IMAGE_BACKEND_WORKER_CONCURRENCY=1
IMAGE_BACKEND_DB_POOL_SIZE=5
IMAGE_BACKEND_DB_MAX_OVERFLOW=2
IMAGE_BACKEND_RECOMMENDATION_DIFY_MODE=mock
IMAGE_BACKEND_RECOMMENDATION_MAX_ACTIVE_PER_OWNER=1
IMAGE_BACKEND_RECOMMENDATION_FORM_TTL_DAYS=3
# Chatflow handoff stays disabled unless explicitly enabled in an isolated acceptance environment.
IMAGE_BACKEND_CHATFLOW_HANDOFF_ENABLED=false
IMAGE_BACKEND_CHATFLOW_FLOW_VERSION=legacy
IMAGE_BACKEND_CHATFLOW_DIFY_MODE=stub
IMAGE_BACKEND_DIFY_APP_ID=
IMAGE_BACKEND_DIFY_WORKFLOW_ID=
IMAGE_BACKEND_GUEST_SESSION_TTL_DAYS=120
IMAGE_BACKEND_GENERATION_RUNTIME_ENABLED=false
IMAGE_BACKEND_TASKS_API_ENABLED=false
IMAGE_BACKEND_PRODUCTION=false
IMAGE_BACKEND_USE_DEV_COOKIE=true
IMAGE_BACKEND_TRUSTED_ORIGINS=["http://127.0.0.1:8001","http://localhost:8001"]
IMAGE_BACKEND_STORAGE_DRIVER=local
IMAGE_BACKEND_PRIVATE_STORAGE_ROOT=/data/private
IMAGE_BACKEND_REFERENCE_UPLOAD_LEASE_SECONDS=1800
IMAGE_BACKEND_REFERENCE_ORPHAN_GRACE_HOURS=24

IMAGE_BACKEND_TEST_RUNTIME_DATABASE_URL=postgresql+psycopg://image_backend_runtime:CHANGE_ME_TEST_RUNTIME_PASSWORD@test-db:5432/image_backend_test
IMAGE_BACKEND_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://image_backend_migrator:CHANGE_ME_TEST_MIGRATOR_PASSWORD@test-db:5432/image_backend_test
IMAGE_BACKEND_TEST_BROKER_URL=amqp://image_backend:CHANGE_ME_TEST_RABBITMQ_PASSWORD@test-rabbitmq:5672/image_backend_test
IMAGE_BACKEND_TEST_GENERATION_RUNTIME_ENABLED=false
IMAGE_BACKEND_TEST_TASKS_API_ENABLED=false
# Separate maintenance secret for isolated R8 cleanup HTTP acceptance only; blank disables that route.
IMAGE_BACKEND_TEST_MAINTENANCE_SECRET=
# For the R8 E2E only, set IMAGE_BACKEND_TEST_WORKER_APP=tests.integration.tasks.r8_e2e_worker:app.
# Leave unset for normal test workers.

BACKEND_API_PORT=8001
IMAGE_BACKEND_TEST_API_PORT=18001
IMAGE_BACKEND_TEST_API_ORIGIN=http://127.0.0.1:18001

# Optional image source overrides. Defaults use same-version Docker Official Images mirrored by public ECR.
# IMAGE_BACKEND_PYTHON_BASE_IMAGE=public.ecr.aws/docker/library/python:3.12.15-slim-bookworm
# IMAGE_BACKEND_POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:18.6-bookworm
# IMAGE_BACKEND_RABBITMQ_IMAGE=public.ecr.aws/docker/library/rabbitmq:4.3.6-management-alpine
